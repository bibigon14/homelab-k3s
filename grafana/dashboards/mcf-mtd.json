    {
      "id": 5,
      "title": "Daily spend trend (last 30 days)",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "grafana-bigquery-datasource", "uid": "bq-billing-export"},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT DATE(usage_start_time) AS time, service.description AS metric, SUM(cost) AS value FROM `dstepanov-gke-platform.billing_export.gcp_billing_export_v1_0108CD_97A262_B94181` WHERE _PARTITIONTIME >= TIMESTAMP(DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)) GROUP BY time, metric ORDER BY time",
        "format": "time_series",
        "location": "US"
      }],
      "fieldConfig": {
