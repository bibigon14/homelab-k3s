    {
      "id": 2,
      "title": "Burn rate (1.0 = on plan)",
      "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "grafana-bigquery-datasource", "uid": "bq-billing-export"},
      "targets": [{
        "refId": "A",
        "rawSql": "WITH mtd AS (SELECT SUM(cost) AS spend FROM `dstepanov-gke-platform.billing_export.gcp_billing_export_v1_0108CD_97A262_B94181` WHERE _PARTITIONTIME >= TIMESTAMP(DATE_TRUNC(CURRENT_DATE(), MONTH))), cal AS (SELECT EXTRACT(DAY FROM CURRENT_DATE()) AS d, EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE(), MONTH)) AS dm) SELECT ROUND(SAFE_DIVIDE(SAFE_DIVIDE(mtd.spend, 10.0), SAFE_DIVIDE(cal.d, cal.dm)), 2) AS burn_rate FROM mtd, cal",
        "format": "table",
        "location": "US"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1.0},
            {"color": "red", "value": 1.5}
          ]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto"}
    },
    {
      "id": 3,
      "title": "Projected month-end spend",
      "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "grafana-bigquery-datasource", "uid": "bq-billing-export"},
      "targets": [{
        "refId": "A",
        "rawSql": "WITH mtd AS (SELECT SUM(cost) AS spend FROM `dstepanov-gke-platform.billing_export.gcp_billing_export_v1_0108CD_97A262_B94181` WHERE _PARTITIONTIME >= TIMESTAMP(DATE_TRUNC(CURRENT_DATE(), MONTH))), cal AS (SELECT EXTRACT(DAY FROM CURRENT_DATE()) AS d, EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE(), MONTH)) AS dm) SELECT ROUND(SAFE_DIVIDE(mtd.spend, cal.d) * cal.dm, 2) AS projected FROM mtd, cal",
        "format": "table",
        "location": "US"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 8},
            {"color": "red", "value": 10}
          ]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto"}
    },
    {
      "id": 4,
      "title": "MTD cost by service",
      "type": "barchart",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "grafana-bigquery-datasource", "uid": "bq-billing-export"},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT service.description AS service, ROUND(SUM(cost), 4) AS cost_usd FROM `dstepanov-gke-platform.billing_export.gcp_billing_export_v1_0108CD_97A262_B94181` WHERE _PARTITIONTIME >= TIMESTAMP(DATE_TRUNC(CURRENT_DATE(), MONTH)) GROUP BY service ORDER BY cost_usd DESC LIMIT 20",
        "format": "table",
        "location": "US"
      }],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4}},
      "options": {"orientation": "horizontal", "xField": "service", "legend": {"showLegend": false}}
