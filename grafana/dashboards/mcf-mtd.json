        "type": "grafana-bigquery-datasource",
        "uid": "bq-billing-export"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH mtd AS (SELECT SUM(cost) AS spend FROM `dstepanov-gke-platform.billing_export.gcp_billing_export_v1_0108CD_97A262_B94181` WHERE _PARTITIONTIME >= TIMESTAMP(DATE_TRUNC(CURRENT_DATE(), MONTH))), cal AS (SELECT EXTRACT(DAY FROM CURRENT_DATE()) AS d, EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE(), MONTH)) AS dm) SELECT ROUND(SAFE_DIVIDE(SAFE_DIVIDE(mtd.spend, 10.0), SAFE_DIVIDE(cal.d, cal.dm)), 2) AS burn_rate FROM mtd, cal",
          "format": "table",
          "location": "US"
        }
